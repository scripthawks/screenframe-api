def app
pipeline {
    agent any
    environment {
        ENV_TYPE = "production"
        PORT = 4087
        NAMESPACE = "screenframe-ru"
        REGISTRY_HOSTNAME = "scripthawks"
        PROJECT = "main-gateway-screenframe-api"
        SERVICE="main-gateway"
        REGISTRY = "registry.hub.docker.com"
        DEPLOYMENT_NAME = "main-gateway-screenframe-api-deployment"
        IMAGE_NAME = "${env.BUILD_ID}_${env.ENV_TYPE}_${env.GIT_COMMIT}"
        DOCKER_BUILD_NAME = "${env.REGISTRY_HOSTNAME}/${env.PROJECT}:${env.IMAGE_NAME}"
    }

    stages {
        stage('Clone repository') {
            steps {
                checkout scm
            }
        }
        stage('Install dependencies') {
                steps {
                    script {
                        sh '''
                           export NVM_DIR="$HOME/.nvm"
                           [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                           nvm use --lts
                           yarn install
                        '''
                    }
                }
        }
        stage('Unit tests') {
            steps {
                script {
                    sh '''
                       export NVM_DIR="$HOME/.nvm"
                       [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                       nvm use --lts
                       yarn test:main-gateway:unit
                    '''
                }
            }
        }
        stage('Int tests') {
                    steps {
                        script {
                            sh '''
                               export NVM_DIR="$HOME/.nvm"
                               [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                               nvm use --lts
                               yarn test:main-gateway:int
                            '''
                        }
                    }
        }
        stage('e2e tests') {
            steps {
                script {
                    sh '''
                       export NVM_DIR="$HOME/.nvm"
                       [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                       nvm use --lts
                       yarn test:main-gateway:e2e
                    '''
                }
            }
        }
        stage('Build docker image') {
            steps {
                echo "Build image started..."
                    script {
                       app = docker.build("${env.DOCKER_BUILD_NAME}", "--build-arg service=${env.SERVICE} --build-arg port=${env.PORT} -f ./apps/${env.SERVICE}/Dockerfile ./")
                    }
                echo "Build image finished..."
            }
        }
        stage('Push docker image') {
             steps {
                 echo "Push image started..."
                     script {
                        docker.withRegistry("https://${env.REGISTRY}", 'screenframe-ru') {
                            app.push("${env.IMAGE_NAME}")
                        }
                     }
                 echo "Push image finished..."
             }
       }
       stage('Delete image local') {
             steps {
                 script {
                    sh "docker rmi -f ${env.DOCKER_BUILD_NAME}"
                 }
             }
        }
        stage('Preparing deployment') {
             steps {
                 echo "Preparing started..."
                     sh 'ls -ltr'
                     sh 'pwd'
                     sh "chmod +x ./apps/${env.SERVICE}/preparingDeploy.sh"
                     sh "./apps/${env.SERVICE}/preparingDeploy.sh ${env.REGISTRY_HOSTNAME} ${env.PROJECT} ${env.IMAGE_NAME} ${env.DEPLOYMENT_NAME} ${env.PORT} ${env.NAMESPACE}"
                     sh "cat ./apps/${env.SERVICE}/deployment.yaml"
             }
        }
        stage('Deploy to Kubernetes') {
             steps {
                 withKubeConfig([credentialsId: 'prod-kubernetes']) {
                    sh "kubectl apply -f ./apps/${env.SERVICE}/deployment.yaml"
                    sh "kubectl rollout status deployment/${env.DEPLOYMENT_NAME} --namespace=${env.NAMESPACE}"
                    
                    sh "kubectl get pods -n screenframe-ru"
    
                    sh "kubectl get services -o wide"
                 }
             }
        }
       stage('Check CORS Configuration') {
    steps {
        script {
            withKubeConfig([credentialsId: 'prod-kubernetes']) {
                sh '''
                    echo "========================================="
                    echo "🔍 ПРОВЕРКА CORS НАСТРОЕК"
                    echo "========================================="
                    
                    # Получаем значение CORS_ORIGINS из секрета
                    echo "📋 CORS_ORIGINS из секрета:"
                    CORS_VALUE=$(kubectl get secret main-gateway-screenframe-api-production-config-secret -n screenframe-ru -o jsonpath="{.data.CORS_ORIGINS}" | base64 -d)
                    echo "$CORS_VALUE"
                    
                    # Проверяем, есть ли Jenkins origin в списке (POSIX-совместимый способ)
                    echo ""
                    echo "🔎 Проверка наличия Jenkins origin (https://jenkins.trainee.it-incubator.io):"
                    if echo "$CORS_VALUE" | grep -q "jenkins.trainee.it-incubator.io"; then
                        echo "✅ Jenkins origin найден в CORS_ORIGINS!"
                    else
                        echo "❌ Jenkins origin НЕ найден в CORS_ORIGINS!"
                        echo "⚠️  Нужно добавить: https://jenkins.trainee.it-incubator.io/job/prd-main-gateway-screenframe-api-pull-request"
                    fi
                    
                    # Получаем список всех переменных из секрета (без jq)
                    echo ""
                    echo "📦 Все ключи в секрете:"
                    kubectl get secret main-gateway-screenframe-api-production-config-secret -n screenframe-ru -o jsonpath="{.data}" | sed 's/ /\n/g' | grep -o '"[^"]*"' || echo "Не удалось получить список ключей"
                    
                    # Проверяем логи пода на наличие CORS ошибок
                    echo ""
                    echo "📋 Последние логи пода (проверка на CORS ошибки):"
                    POD=$(kubectl get pods -n screenframe-ru -l app=main-gateway-screenframe-api -o jsonpath="{.items[0].metadata.name}" 2>/dev/null || echo "")
                    if [ -n "$POD" ]; then
                        echo "Под: $POD"
                        kubectl logs $POD -n screenframe-ru --tail=20 | grep -i cors || echo "CORS ошибок в логах не найдено"
                    else
                        echo "Не удалось найти под с приложением"
                    fi
                    
                    echo "========================================="
                '''
            }
        }
    }
}
    }
}
