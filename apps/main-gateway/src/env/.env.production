VERIFY_EMAIL_PATH=auth/verify-email
PASSWORD_RECOVERY_PATH=auth/password-recovery

#TOKENS
CONFIRMATION_TOKEN_EXPIRATION=


#JWT TOKEN
ACCESS_TOKEN_SECRET=your-access-token-secret-test
REFRESH_TOKEN_SECRET=your-refresh-token-secret-test
