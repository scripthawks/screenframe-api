NODE_ENV=
PORT=
GLOBAL_PREFIX=

#SWAGGER
IS_SWAGGER_ENABLED=0

#DB
DATABASE_URL=
IS_DB_SYNCHRONIZE=0
IS_DB_LOGGING=0

#CORS 
CORS_ORIGINS=https://screenframe.ru,https://www.screenframe.ru


#MAIL
MAIL_PASS=
MAIL_SERVICE=gmail
MAIL_USER=
IZ_MAILER_TLS_VERIFICATION=0
